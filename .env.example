# Datenbank:
#  - Entwicklung (ohne Docker):  file:./luemobil.db          (SQLite, Standard)
#  - Produktion (VPS):           postgres://user:pass@postgres:5432/luemobil
DATABASE_URI=file:./luemobil.db

# Payload-Secret: langen Zufallswert setzen, z. B. `openssl rand -hex 32`
PAYLOAD_SECRET=BITTE_AENDERN_openssl_rand_hex_32

# Erster Admin-User (wird vom Seed-Skript angelegt, falls nicht vorhanden)
ADMIN_EMAIL=jan.hedtfeld@lumimorix.de
ADMIN_PASSWORD=BITTE_AENDERN

# Öffentliche URL (Produktion, z. B. https://luemobil.swl-innovation.de)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Testphase: Seite aus Suchmaschinen heraushalten (noindex + robots.txt-Sperre).
# Zum echten Launch auf false setzen oder entfernen.
SITE_NOINDEX=true

# Testphase: gesamte Seite (inkl. /admin) hinter Passwortschutz (Basic Auth).
# Wirkt lokal UND in Produktion. Zum Deaktivieren entfernen oder auf false setzen.
# 2. Schritt später: durch Keycloak/OIDC-Login ersetzen (siehe src/middleware.ts).
SITE_BASIC_AUTH=true
SITE_BASIC_AUTH_USER=luemobil
SITE_BASIC_AUTH_PASSWORD=BITTE_AENDERN

# Betriebsmodi (Cockpit /cockpit und Kundencheck /kundencheck sind IMMER per
# Keycloak + Rolle geschützt — unabhängig von den beiden Schaltern):
#   Öffentliche Seite:   SITE_KEYCLOAK_AUTH=false · SITE_BASIC_AUTH=false
#   Sammel-Passwort:     SITE_KEYCLOAK_AUTH=false · SITE_BASIC_AUTH=true
#   Ganze Seite/Keycloak: SITE_KEYCLOAK_AUTH=true  · SITE_BASIC_AUTH=false
# Interne Bereiche nur mit Keycloak-Realm-Rolle (siehe COCKPIT_*ROLE* weiter unten).
# Voraussetzung: die KEYCLOAK_*/COCKPIT_CLIENT_* Werte weiter unten.
SITE_KEYCLOAK_AUTH=false

# E-Mail-Benachrichtigung an Redakteur:innen (SMTP). Ohne SMTP_HOST ist der
# Versand deaktiviert (Mails landen dann nur in der Server-Konsole).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true bei Port 465 (SSL), sonst false (STARTTLS)
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@swl-innovation.de
EMAIL_FROM_NAME=LüMobil Hilfecenter

# Jira-Anbindung: Sobald ein bekannter Fehler den Status „Gemeldet" erhält,
# wird automatisch EIN Jira-Ticket angelegt und die Ticket-ID (z. B. LUEM-42)
# im Datensatz gespeichert. Solange nicht alle vier Pflichtwerte gesetzt sind,
# bleibt die Anbindung inaktiv (keine Tickets werden erzeugt).
JIRA_BASE_URL=                       # z. B. https://stadtwerke-luebeck.atlassian.net
JIRA_EMAIL=                          # E-Mail des Atlassian-Kontos zum API-Token
JIRA_API_TOKEN=                      # Atlassian-API-Token (Jira Cloud)
JIRA_PROJECT_KEY=                    # Ziel-Projekt, z. B. LUEM
JIRA_ISSUE_TYPE=Bug                  # Vorgangstyp (Standard: Bug)
JIRA_SET_PRIORITY=false              # true, um Schweregrad → Priorität zu senden

# --- Migrations-Cockpit (/cockpit) -------------------------------------------
# Interner Support-Bereich (Keycloak-Migration monitoren). Zugriff nur mit
# Keycloak-Realm-Rolle „support". Secrets NUR serverseitig.

# Mock-Modus: gegen eingebaute Demo-Daten entwickeln (kein echtes Keycloak/Abo,
# Login per Dev-Login ohne Passwort). Für Produktion auf false setzen/entfernen.
COCKPIT_MOCK=true
COCKPIT_ENV=dev                      # dev | test | live (Umgebungs-Badge)

# Keycloak-Server (für beide Realms derselbe Host)
KEYCLOAK_URL=                        # z. B. https://auth.swl-innovation.de
APP_BASE_URL=http://localhost:3000   # Basis für die OIDC-Redirect-URI (…/api/auth/callback)
# Rollen (im Login-Realm). Kundencheck und Migrations-Cockpit sind getrennt:
COCKPIT_SUPPORT_ROLE=support         # schaltet BEIDE Bereiche frei (bisherige Rolle)
COCKPIT_ROLE_KUNDENCHECK=kundencheck # nur Kundencheck
COCKPIT_ROLE_MIGRATION=cockpit       # nur Migrations-Cockpit (inkl. Patris-Upload, Reports)

# Daten-Realm (Kunden): Quelle für Nutzerzahl + Events über einen Service Account.
# Der Service-Account-Client lebt in DIESEM Realm und braucht die realm-management-
# Client-Rollen view-users + view-events.
KEYCLOAK_REALM=mpluebeck
COCKPIT_CLIENT_ID=                   # Service-Account-Client in mpluebeck
COCKPIT_CLIENT_SECRET=               # dessen Client-Secret

# Login-Realm (Mitarbeitende): getrennt, damit Personal-Konten NICHT in der
# Kundenzählung landen. Der OIDC-Login-Client lebt in DIESEM Realm (Standard-Flow).
# Leer lassen = Einzel-Realm-Betrieb (Login läuft dann auch über KEYCLOAK_REALM).
KEYCLOAK_AUTH_REALM=                 # z. B. swl-intern
OIDC_CLIENT_ID=                      # Login-Client im Mitarbeiter-Realm
OIDC_CLIENT_SECRET=                  # dessen Client-Secret

# Synthetischer Login-Check (Status-Ampel „Login (Test)"). Optional.
# Prüft die KUNDEN-Anmeldung Ende-zu-Ende: Testkunde meldet sich per ROPC am
# Kunden-Realm an (löst dieselbe Aboonline-Prüfung/Migration aus wie ein echter
# Login). Der genutzte Client braucht „Direct Access Grants".
# Standard: Realm = KEYCLOAK_REALM, Client = COCKPIT_CLIENT_ID/SECRET (also der
# luemobil-cockpit-Client) — dann genügen SYNTH_LOGIN_USER/PASSWORD unten, wenn
# an diesem Client DAG aktiviert ist. Für einen eigenen Monitoring-Client die
# folgenden drei Werte überschreiben.
# SYNTH_LOGIN_REALM=mpluebeck
# SYNTH_LOGIN_CLIENT_ID=
# SYNTH_LOGIN_CLIENT_SECRET=
SYNTH_LOGIN_USER=                     # Testkunde (E-Mail/Username)
SYNTH_LOGIN_PASSWORD=

# Aboonline-Webservice (nur lesende AccountCheck-Abfrage)
ABO_WS_URL=                          # Test: https://testsystem-abo.swhl.de/ws/v1 · Live: https://abo.swhl.de/ws/v1
ABO_WS_TOKEN=                        # Bearer-Token des Webservices

# Migrationsfortschritt: Nenner (Gesamtkundenzahl) für die Prozentanzeige
COCKPIT_KUNDEN_GESAMT=

# Störungs-Benachrichtigung (Job „pnpm job:health", minütlich per Cron).
# Mailt bei Zustandswechsel (Störung/Entwarnung) an ALERT_EMAIL — nutzt den
# SMTP-Adapter oben (SMTP_HOST muss gesetzt sein). Leer = kein Mail-Alerting.
ALERT_EMAIL=
ALERT_FAIL_THRESHOLD=2                # Alarm erst nach so vielen Fehlversuchen in Folge
# Test: erzwingt eine Störung für die genannten Dienste (nur zum Alert-Testen),
# z. B.: HEALTH_FORCE_FAIL=login pnpm job:health   → löst eine Alarm-Mail aus.
# HEALTH_FORCE_FAIL=

# Grafische Reports (HTML-Mail + PDF-Anhang, Hilfecenter-Design) gehen an
# dieselbe Adresse (ALERT_EMAIL). Manuell per Button im Cockpit auslösbar oder
# automatisch per Cron (siehe CRON_SECRET unten).

# Shared Secret für die HTTP-getriggerten Cron-Jobs (Monitoring, Aggregation,
# Reports). In Produktion (Docker-Standalone) laufen die Jobs NICHT als tsx-CLI,
# sondern als abgesicherter HTTP-Endpunkt /api/cockpit/cron, den der Host-Cron
# per curl anstößt. Leer = Cron-Endpunkt deaktiviert (HTTP 503).
#   openssl rand -hex 32   → als CRON_SECRET setzen
# Host-Crontab (crontab -e), Domain + Secret einsetzen:
#   * * * * *   curl -fsS -X POST -H "x-cron-secret: $SEC" "https://DOMAIN/api/cockpit/cron?job=health"    >/dev/null
#   * * * * *   curl -fsS -X POST -H "x-cron-secret: $SEC" "https://DOMAIN/api/cockpit/cron?job=aggregate" >/dev/null
#   0 * * * *   curl -fsS -X POST -H "x-cron-secret: $SEC" "https://DOMAIN/api/cockpit/cron?job=report&period=hour"  >/dev/null
#   30 6 * * *  curl -fsS -X POST -H "x-cron-secret: $SEC" "https://DOMAIN/api/cockpit/cron?job=report&period=day"   >/dev/null
#   30 6 * * 1  curl -fsS -X POST -H "x-cron-secret: $SEC" "https://DOMAIN/api/cockpit/cron?job=report&period=week"  >/dev/null
#   30 6 1 * *  curl -fsS -X POST -H "x-cron-secret: $SEC" "https://DOMAIN/api/cockpit/cron?job=report&period=month" >/dev/null
# (lokal ohne Docker gehen weiter die CLI-Jobs: pnpm job:health · pnpm job:cockpit · pnpm job:report <period>)
CRON_SECRET=

# Optional: eigenes Secret zum Signieren des Session-Cookies (Fallback: PAYLOAD_SECRET)
# SESSION_SECRET=

# --- LüMobil Ticket-API (Kundencheck: Käufe in der App) ----------------------
# Serverseitiger Aufruf POST {URL}/rpc/tickets_fuer_email. Token NIE ins Repo
# und nie in diese Datei im Klartext, wenn es sich vermeiden lässt:
# bevorzugt als Datei (wird bei jedem Aufruf neu gelesen → Token-Wechsel ohne
# Neustart/Deployment). Datei nur für den App-Nutzer lesbar machen (chmod 600).
LUEMOBIL_API_URL=                    # Dev: https://tickets-api.local:8443 (bzw. https://localhost:8443)
LUEMOBIL_API_TOKEN_FILE=             # z. B. /Users/<ich>/.config/luemobil-hilfecenter/luemobil_api_token
# LUEMOBIL_API_TOKEN=                # Alternative zur Datei (Wechsel erfordert Neustart)
LUEMOBIL_API_CA=                     # Nur Dev: Pfad zur ca.crt der Ticket-API; Prod: leer (öffentliches Zertifikat)
