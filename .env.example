# Datenbank:
#  - Entwicklung (ohne Docker):  file:./luemobil.db          (SQLite, Standard)
#  - Produktion (VPS):           postgres://user:pass@postgres:5432/luemobil
DATABASE_URI=file:./luemobil.db

# Payload-Secret: langen Zufallswert setzen, z. B. `openssl rand -hex 32`
PAYLOAD_SECRET=BITTE_AENDERN_openssl_rand_hex_32

# Erster Admin-User (wird vom Seed-Skript angelegt, falls nicht vorhanden)
ADMIN_EMAIL=jan.hedtfeld@lumimorix.de
ADMIN_PASSWORD=BITTE_AENDERN

# Öffentliche URL (Produktion, z. B. https://luemobil.swl-innovation.de)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Testphase: Seite aus Suchmaschinen heraushalten (noindex + robots.txt-Sperre).
# Zum echten Launch auf false setzen oder entfernen.
SITE_NOINDEX=true

# Testphase: gesamte Seite (inkl. /admin) hinter Passwortschutz (Basic Auth).
# Wirkt lokal UND in Produktion. Zum Deaktivieren entfernen oder auf false setzen.
# 2. Schritt später: durch Keycloak/OIDC-Login ersetzen (siehe src/middleware.ts).
SITE_BASIC_AUTH=true
SITE_BASIC_AUTH_USER=luemobil
SITE_BASIC_AUTH_PASSWORD=BITTE_AENDERN

# Alternative zur Basic Auth: gesamte Seite per Keycloak-Login absichern.
# Nur Nutzer mit der Rolle COCKPIT_SUPPORT_ROLE (Standard: support) kommen rein.
# Wenn aktiv, SITE_BASIC_AUTH auf false setzen (sonst doppelter Login).
# Voraussetzung: die KEYCLOAK_*/COCKPIT_CLIENT_* Werte weiter unten.
SITE_KEYCLOAK_AUTH=false

# E-Mail-Benachrichtigung an Redakteur:innen (SMTP). Ohne SMTP_HOST ist der
# Versand deaktiviert (Mails landen dann nur in der Server-Konsole).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true bei Port 465 (SSL), sonst false (STARTTLS)
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@swl-innovation.de
EMAIL_FROM_NAME=LüMobil Hilfecenter

# Jira-Anbindung: Sobald ein bekannter Fehler den Status „Gemeldet" erhält,
# wird automatisch EIN Jira-Ticket angelegt und die Ticket-ID (z. B. LUEM-42)
# im Datensatz gespeichert. Solange nicht alle vier Pflichtwerte gesetzt sind,
# bleibt die Anbindung inaktiv (keine Tickets werden erzeugt).
JIRA_BASE_URL=                       # z. B. https://stadtwerke-luebeck.atlassian.net
JIRA_EMAIL=                          # E-Mail des Atlassian-Kontos zum API-Token
JIRA_API_TOKEN=                      # Atlassian-API-Token (Jira Cloud)
JIRA_PROJECT_KEY=                    # Ziel-Projekt, z. B. LUEM
JIRA_ISSUE_TYPE=Bug                  # Vorgangstyp (Standard: Bug)
JIRA_SET_PRIORITY=false              # true, um Schweregrad → Priorität zu senden

# --- Migrations-Cockpit (/cockpit) -------------------------------------------
# Interner Support-Bereich (Keycloak-Migration monitoren). Zugriff nur mit
# Keycloak-Realm-Rolle „support". Secrets NUR serverseitig.

# Mock-Modus: gegen eingebaute Demo-Daten entwickeln (kein echtes Keycloak/Abo,
# Login per Dev-Login ohne Passwort). Für Produktion auf false setzen/entfernen.
COCKPIT_MOCK=true
COCKPIT_ENV=dev                      # dev | test | live (Umgebungs-Badge)

# Keycloak-Server (für beide Realms derselbe Host)
KEYCLOAK_URL=                        # z. B. https://auth.swl-innovation.de
APP_BASE_URL=http://localhost:3000   # Basis für die OIDC-Redirect-URI (…/api/auth/callback)
COCKPIT_SUPPORT_ROLE=support         # Rolle (im Login-Realm), die Zugriff gewährt

# Daten-Realm (Kunden): Quelle für Nutzerzahl + Events über einen Service Account.
# Der Service-Account-Client lebt in DIESEM Realm und braucht die realm-management-
# Client-Rollen view-users + view-events.
KEYCLOAK_REALM=mpluebeck
COCKPIT_CLIENT_ID=                   # Service-Account-Client in mpluebeck
COCKPIT_CLIENT_SECRET=               # dessen Client-Secret

# Login-Realm (Mitarbeitende): getrennt, damit Personal-Konten NICHT in der
# Kundenzählung landen. Der OIDC-Login-Client lebt in DIESEM Realm (Standard-Flow).
# Leer lassen = Einzel-Realm-Betrieb (Login läuft dann auch über KEYCLOAK_REALM).
KEYCLOAK_AUTH_REALM=                 # z. B. swl-intern
OIDC_CLIENT_ID=                      # Login-Client im Mitarbeiter-Realm
OIDC_CLIENT_SECRET=                  # dessen Client-Secret

# Aboonline-Webservice (nur lesende AccountCheck-Abfrage)
ABO_WS_URL=                          # Test: https://testsystem-abo.swhl.de/ws/v1 · Live: https://abo.swhl.de/ws/v1
ABO_WS_TOKEN=                        # Bearer-Token des Webservices

# Migrationsfortschritt: Nenner (Gesamtkundenzahl) für die Prozentanzeige
COCKPIT_KUNDEN_GESAMT=

# Optional: eigenes Secret zum Signieren des Session-Cookies (Fallback: PAYLOAD_SECRET)
# SESSION_SECRET=
